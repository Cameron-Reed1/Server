# Copied from Arch Linux's default /etc/profile
function append_path() {
    [ ! -d "$1" ] && return
    case ":$PATH:" in
        *:"$1":*)
            ;;
        *)
            PATH="${PATH:+$PATH:}$1"
    esac
}

append_path "$HOME/.local/bin"
append_path "$HOME/go/bin"
append_path "$ZVM_PATH/bin"

export PATH
unset -f append_path



EDITOR="vim"
if command -v nvim > /dev/null; then
    EDITOR="nvim"
fi
export EDITOR


if command -v zvm 2> /dev/null; then
    export ZVM_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/zvm"
fi
